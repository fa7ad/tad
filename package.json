{
  "name": "tad-root",
  "version": "0.14.0",
  "description": "Yarn monorepo for Tabular data viewer libraries and apps",
  "private": true,
  "overrides": {
    "ws": "8.18.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.1",
    "typescript": "5.9.2"
  },
  "scripts": {
    "clean": "yarn workspaces foreach -A run clean",
    "build": "yarn workspaces foreach -At run build",
    "build:base": "yarn workspace reltab run build && yarn workspace aggtree run build",
    "build:drivers": "yarn workspaces foreach -pA 'reltab-*' run build",
    "build:components": "yarn workspace tadviewer run build",
    "build:app": "yarn workspace tad run build",
    "distribute": "yarn workspace tad run distribute",
    "test": "yarn workspaces foreach -A run test"
  },
  "workspaces": [
    "packages/*",
    "packages/tad/app"
  ],
  "packageManager": "yarn@4.9.4",
  "dependencies": {
    "node-gyp": "^11.4.2"
  }
}
