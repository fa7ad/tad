{
  "name": "tad-root",
  "version": "0.14.0",
  "description": "Yarn monorepo for Tabular data viewer libraries and apps",
  "private": true,
  "overrides": {
    "ws": "8.18.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.1.3",
    "node-gyp": "^11.4.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "clean": "yarn workspaces foreach -A run clean",
    "build": "yarn workspaces foreach -At run build",
    "release:app": "yarn workspace tad run release",
    "release:app:dev": "yarn workspace tad run release:dev",
    "test": "yarn workspaces foreach -A run test"
  },
  "workspaces": [
    "packages/*",
    "packages/tad/app"
  ],
  "packageManager": "yarn@4.9.4"
}
