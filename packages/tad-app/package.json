{
  "name": "tad",
  "version": "0.14.0",
  "homepage": "https://www.tadviewer.com",
  "description": "Tabular data viewer desktop app, built with Electron",
  "main": "dist/main.bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonycourtney/tad.git"
  },
  "scripts": {
    "clean": "rm -vrf dist",
    "build:dir": "mkdir -p dist",
    "build:tadviewer-assets": "cp -vr ../tadviewer/dist/ dist/",
    "build:html": "cp -vr html/ dist/",
    "build:preload": "cp -v app/preload.js dist/preload.js",
    "build:icon": "mkdir -p buildRes && cp -v res/AppIcon.icns buildRes/icon.icns && cp -v res/blue_external_drive.icns buildRes/dmgIcon.icns",
    "build-assets": "yarn build:dir && yarn build:html && yarn build:icon && yarn build:preload",
    "build-dev": "yarn build-assets && webpack --mode development",
    "build-prod": "yarn build-assets && webpack --env prod --mode production",
    "build": "electron-builder install-app-deps && yarn build-prod",
    "watch": "webpack --mode development --watch",
    "watch-prod": "webpack --env prod --mode production --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "dist-arm64": "electron-builder --arm64 --publish=never",
    "distribute": "electron-builder",
    "start": "electron ."
  },
  "keywords": [
    "relational",
    "sql",
    "database"
  ],
  "author": "Antony Courtney <antony@antonycourtney.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@blueprintjs/icons": "^4.10.1",
    "@electron/notarize": "^2.3.2",
    "@types/command-line-args": "^5.2.0",
    "@types/command-line-usage": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.2.4",
    "@types/react-select": "^5.0.0",
    "@types/slickgrid": "^2.1.31",
    "ajv": "^6.9.1",
    "css-loader": "^6.5.1",
    "duplicate-package-checker-webpack-plugin": "^3.0.0",
    "electron": "31.0.1",
    "electron-builder": "^24.13.3",
    "file-loader": "^6.2.0",
    "image-webpack-loader": "^8.0.1",
    "less": "^3.13.1",
    "less-loader": "^10.2.0",
    "mkdirp": "^1.0.4",
    "recursive-copy-cli": "^1.0.20",
    "resolve-url-loader": "^4.0.0",
    "rimraf": "^5.0.5",
    "sass": "^1.80.6",
    "sass-loader": "^14.2.1",
    "source-map-loader": "^3.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.2.6",
    "typescript": "5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^4.9.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "aggtree": "workspace:*",
    "babel-cli": "^6.26.0",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.3",
    "console.table": "^0.10.0",
    "electron-log": "^4.4.4",
    "electron-updater": "^4.6.1",
    "fast-csv": "^4.3.6",
    "loglevel": "^1.8.0",
    "oneref": "^0.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reltab": "workspace:*",
    "reltab-duckdb": "workspace:*",
    "reltab-fs": "workspace:*",
    "source-map-support": "^0.5.21",
    "tadviewer": "workspace:*"
  }
}
