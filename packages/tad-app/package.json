{
  "name": "tad",
  "version": "0.14.0",
  "homepage": "https://www.tadviewer.com",
  "description": "Tabular data viewer desktop app, built with Electron",
  "main": "dist/main.bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonycourtney/tad.git"
  },
  "scripts": {
    "clean": "rm -rf dist buildRes",
    "build:dev": "webpack --mode development \"$@\"",
    "build": "webpack --mode production --env prod",
    "watch": "yarn build:dev --watch",
    "start": "electron .",
    "release": "electron-builder",
    "release:dev": "yarn release --publish=never",
    "release:dev:dir": "yarn release --dir"
  },
  "keywords": [
    "relational",
    "sql",
    "database"
  ],
  "author": "Antony Courtney <antony@antonycourtney.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@blueprintjs/icons": "^4.10.1",
    "@electron/notarize": "^2.3.2",
    "@types/command-line-args": "^5.2.0",
    "@types/command-line-usage": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.2.4",
    "@types/react-select": "^5.0.0",
    "@types/slickgrid": "^2.1.31",
    "ajv": "^6.9.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.5.1",
    "duplicate-package-checker-webpack-plugin": "^3.0.0",
    "electron": "31.0.1",
    "electron-builder": "^24.13.3",
    "file-loader": "^6.2.0",
    "image-webpack-loader": "^8.0.1",
    "jest": "^30.1.3",
    "less": "^3.13.1",
    "less-loader": "^10.2.0",
    "prettier": "^3.6.2",
    "recursive-copy-cli": "^1.0.20",
    "resolve-url-loader": "^4.0.0",
    "sass": "^1.80.6",
    "sass-loader": "^14.2.1",
    "source-map-loader": "^3.0.1",
    "style-loader": "^3.3.1",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.2.6",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^4.9.1",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "aggtree": "workspace:*",
    "babel-cli": "^6.26.0",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.3",
    "console.table": "^0.10.0",
    "electron-log": "^4.4.4",
    "electron-updater": "^4.6.1",
    "fast-csv": "^4.3.6",
    "loglevel": "^1.8.0",
    "oneref": "^0.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reltab": "workspace:*",
    "reltab-duckdb": "workspace:*",
    "reltab-fs": "workspace:*",
    "source-map-support": "^0.5.21",
    "tadviewer": "workspace:*"
  }
}
